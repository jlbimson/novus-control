# Copy this file to .env and fill in your device's details.

# IP address of the CG WiFi module on your LAN.
MODBUS_HOST=192.168.1.50

# Modbus TCP port the CG WiFi module listens on.
# 502 is the Modbus standard; some WiFi-to-serial modules use a different
# port (e.g. 8899, 6722). Check the module's own setup page/app if 502
# doesn't connect.
MODBUS_PORT=502

# Modbus slave/unit ID of the inverter/BMS behind the module. 1 is the
# common default.
MODBUS_UNIT_ID=1

# How often (seconds) to poll the device and log a new history point.
POLL_INTERVAL_SECONDS=5

# Local port to expose the web UI on.
HTTP_PORT=8080
